APP_ENV=dev
DEBUG=false

# Domains / CORS
API_DOMAIN=api.pawpalai.cn
ADMIN_DOMAIN=admin.pawpalai.cn
STAGING_API_DOMAIN=staging.api.pawpalai.cn
CORS_ORIGINS=http://localhost:10086,http://localhost:3001,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://petshop:petshop123@localhost:5432/petshop

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
METRICS_TOKEN=local-metrics-token
ACCESS_TOKEN_EXPIRE_DAYS=7

# WeChat Mini Program
WECHAT_APP_ID=your-app-id
WECHAT_APP_SECRET=your-app-secret

# AI/LLM
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o

# Aliyun DashScope (Bailian Platform)
DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_MODEL=deepseek-v4-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: Other LLM providers
# ERNIE_API_KEY=...
# QIANWEN_API_KEY=...

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=petshop-meili-key
