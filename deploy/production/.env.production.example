# Environment mode (dev | prod)
APP_ENV=prod
DEBUG=false

# Backend
API_DOMAIN=api.pawpalai.cn
ADMIN_DOMAIN=admin.pawpalai.cn
STAGING_API_DOMAIN=staging.api.pawpalai.cn
CORS_ORIGINS=https://api.pawpalai.cn,https://admin.pawpalai.cn,https://staging.api.pawpalai.cn
POSTGRES_PASSWORD=<replace-with-strong-postgres-password>
DATABASE_URL=postgresql+asyncpg://petshop:<replace-with-strong-postgres-password>@postgres:5432/petshop
REDIS_URL=redis://redis:6379/0
SECRET_KEY=<generate-with: openssl rand -hex 32>
METRICS_TOKEN=<generate-with: openssl rand -hex 32>
WECHAT_APP_ID=<your-wechat-app-id>
WECHAT_APP_SECRET=<your-wechat-app-secret>
DASHSCOPE_API_KEY=<your-dashscope-api-key>
DASHSCOPE_MODEL=deepseek-v4-flash
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=<your-meilisearch-key>
ACCESS_TOKEN_EXPIRE_DAYS=7
