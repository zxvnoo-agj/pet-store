# Environment mode (dev | staging | prod)
APP_ENV=staging
DEBUG=false

# Backend (staging)
API_DOMAIN=staging.api.pawpalai.cn
ADMIN_DOMAIN=admin.pawpalai.cn
STAGING_API_DOMAIN=staging.api.pawpalai.cn
CORS_ORIGINS=https://staging.api.pawpalai.cn,http://localhost:10086,http://localhost:3001
POSTGRES_PASSWORD=<replace-with-strong-staging-postgres-password>
DATABASE_URL=postgresql+asyncpg://petshop:<replace-with-strong-staging-postgres-password>@postgres:5432/petshop_staging
REDIS_URL=redis://redis:6379/1
SECRET_KEY=<generate-with: openssl rand -hex 32>
METRICS_TOKEN=<generate-with: openssl rand -hex 32>
WECHAT_APP_ID=<your-wechat-app-id-staging>
WECHAT_APP_SECRET=<your-wechat-app-secret-staging>
DASHSCOPE_API_KEY=<your-dashscope-api-key>
DASHSCOPE_MODEL=deepseek-v4-flash
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=<your-meilisearch-key>
ACCESS_TOKEN_EXPIRE_DAYS=7
